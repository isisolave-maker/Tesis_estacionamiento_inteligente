  def bucle_monitoreo(self):
    try:
      arduino = serial.Serial(puerto_arduino, 9600, timeout=1)
      time.sleep(2)
      arduino.reset_input_buffer()
      lecturas_ocupado = 0

      print("\n=== MONITOREO SANTIAGO CHILE + BLYNK ACTIVO ===\n")

      while self.ejecutando:
        dt_chile, dia, mes, anio, hora_txt = obtener_datos_tiempo_google()

        t_inicio = time.perf_counter()
        arduino.write(b"E")
        linea = arduino.readline().decode("utf-8", errors="ignore").strip()
        latencia_ms = (time.perf_counter() - t_inicio) * 1000

        if linea and linea not in ["SENSORES_APAGADOS", "ERROR_LECTURA"]:
          try:
            distancia_cm = float(linea)

            # Logica de deteccion y reinicio automatico de estado
            if (
                distancia_cm > DISTANCIA_MINIMA_VALIDA
                and distancia_cm < DISTANCIA_UMBRAL_CM
            ):
              lecturas_ocupado += 1
            else:
              lecturas_ocupado = 0
              # Al desocuparse, reseteamos la memoria deque con 1.0 (libre)
              historial_lecturas.clear()
              historial_lecturas.extend([1.0] * 10)

            if lecturas_ocupado >= MUESTRAS_REQUERIDAS:
              estado_actual = "OCUPADO"
            elif lecturas_ocupado > 0:
              estado_actual = "DETECTANDO"
            else:
              estado_actual = "DISPONIBLE"

            # Inferencia IA con secuencia temporal real
            minutos = (
                predecir_minutos(distancia_cm, lecturas_ocupado)
                if estado_actual == "OCUPADO"
                else 0
            )

            # 1. BD SQLite
            db_id = guardar_db(
                dia, mes, anio, hora_txt, distancia_cm, estado_actual
            )

            # 2. Blynk HTTPS Batch
            threading.Thread(
                target=enviar_a_blynk,
                args=(estado_actual, minutos, distancia_cm),
                daemon=True,
            ).start()

            # 3. Output Json en Consola
            registro_dict = {
                "id": db_id,
                "dia": dia,
                "mes": mes,
                "anio": anio,
                "hora": hora_txt,
                "distancia_cm": round(distancia_cm, 2),
                "estado": estado_actual,
                "confirmacion_lecturas": f"{lecturas_ocupado}/4",
                "tiempo_respuesta_ms": round(latencia_ms, 2),
                "minutos_predichos_ia": minutos,
            }
            print("\n  [LECTURA EN TIEMPO REAL - ESTRUCTURA JSON]:")
            print(json.dumps(registro_dict, ensure_ascii=False, indent=4))
            print(
                "Registro guardado en .db y transmitido a"
                " Blynk\n------------------------------------------------------------------"
            )

            # 4. Interfaz grafica Tkinter
            self.root.after(
                0,
                self.actualizar_gui,
                estado_actual,
                minutos,
                lecturas_ocupado,
                distancia_cm,
                latencia_ms,
                db_id,
                hora_txt,
            )

          except ValueError:
            print(f"[{hora_txt}] Lectura serial no valida recibida: {linea}")

        time.sleep(INTERVALO_LECTURA)

    except Exception as e:
      print(f"Error en la comunicacion Serial: {e}")


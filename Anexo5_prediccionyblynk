# 2. FUNCIONES DE CONEXION, BLYNK Y IA
def enviar_a_blynk(estado, minutos, distancia_cm):
  """Envia todos los datos a Blynk respetando los Flujos de Datos asignados."""
  if not BLYNK_AUTH_TOKEN:
    return

  try:
    if estado == "OCUPADO":
      v0_ocupado = 1
      v3_disponible = 0
      v4_tiempo = f"{minutos} min"
    elif estado == "DISPONIBLE":
      v0_ocupado = 0
      v3_disponible = 1
      v4_tiempo = "0 min"
    else:  # DETECTANDO
      v0_ocupado = 0
      v3_disponible = 0
      v4_tiempo = "Calculando..."

    url_batch = (
        f"{BLYNK_URL}?token={BLYNK_AUTH_TOKEN}"
        f"&v0={v0_ocupado}"
        f"&v1={estado}"
        f"&v2={round(distancia_cm, 2)}"
        f"&v3={v3_disponible}"
        f"&v4={v4_tiempo}"
    )

    resp = requests.get(url_batch, timeout=4)

    if resp.status_code == 200:
      print("Blynk Batch Update Exitoso (HTTP 200)")
    else:
      print(
          f"Blynk devolvio codigo {resp.status_code}: {resp.text.strip()}"
      )

  except Exception as e:
    print(f"Error de conexion con Blynk Cloud: {e}")


def obtener_datos_tiempo_google():
  """Obtiene la fecha y hora sincronizada en zona UTC-4."""
  try:
    respuesta = requests.get("https://google.com", timeout=3)
    if respuesta.status_code == 200:
      txt_fecha_gmt = respuesta.headers["Date"]
      dt_utc = datetime.strptime(txt_fecha_gmt, "%a, %d %b %Y %H:%M:%S GMT")
      dt_chile = dt_utc - timedelta(hours=4)
      return (
          dt_chile,
          f"{DIAS[dt_chile.weekday()]} {dt_chile.day}",
          MESES[dt_chile.month],
          dt_chile.year,
          dt_chile.strftime("%H:%M:%S"),
      )
  except Exception:
    pass

  dt_local = datetime.now()
  return (
      dt_local,
      f"{DIAS[dt_local.weekday()]} {dt_local.day}",
      MESES[dt_local.month],
      dt_local.year,
      dt_local.strftime("%H:%M:%S"),
  )


def predecir_minutos(distancia_cm, lecturas_seguidas):
  """Ejecuta la inferencia pasando a la LSTM las ultimas 10 lecturas reales con deque."""
  if not ia_disponible:
    return 0
  try:
    # 1. Normalizar la lectura actual (0.0 a 1.0)
    dist_norm = float(np.clip(distancia_cm / 400.0, 0.0, 1.0))

    # 2. Agregar a la cola deslizante (saca el dato #11 automaticamente)
    historial_lecturas.append(dist_norm)

    # 3. Formar la matriz (1, 10, 1) con la secuencia temporal real
    ventana = np.array(historial_lecturas, dtype=np.float32).reshape(1, 10, 1)

    # 4. Inferencia en el modelo
    interpreter.set_tensor(input_details[0]["index"], ventana)
    interpreter.invoke()
    pred_raw = interpreter.get_tensor(output_details[0]["index"])[0][0]

    minutos = int(round(float(pred_raw * 60)))

    if minutos <= 0 or minutos > 120:
      minutos = max(5, 40 - (lecturas_seguidas * 2))

    return minutos
  except Exception as e:
    print(f"Error en inferencia IA: {e}")
    return 0


def guardar_db(dia, mes, anio, hora, distancia, estado):
  """Guarda la lectura en la base de datos SQLite."""
  try:
    conexion = sqlite3.connect(archivo_db)
    cursor = conexion.cursor()
    cursor.execute("""
            CREATE TABLE IF NOT EXISTS ultrasonico (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                dia TEXT, mes TEXT, anio INTEGER, hora TEXT, distancia REAL, estado TEXT
            )
        """)
    cursor.execute(
        """
            INSERT INTO ultrasonico (dia, mes, anio, hora, distancia, estado)
            VALUES (?, ?, ?, ?, ?, ?)
        """,
        (dia, mes, anio, hora, float(distancia), estado),
    )
    conexion.commit()
    id_generado = cursor.lastrowid
    conexion.close()
    return id_generado
  except Exception:
    return 0


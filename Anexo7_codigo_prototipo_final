# FUNCIONES AUXILIARES DE BLYNK
def enviar_datos_blynk(
    estados, asignacion, tiempo_ia_val=0, servidor_activo=True
):
    """Envía actualizaciones individuales a Blynk en segundo plano."""

    def _tarea_envio():
        if BLYNK_AUTH_TOKEN == "TU_BLYNK_AUTH_TOKEN_AQUI":
            print("BLYNK_AUTH_TOKEN no configurado, se omite el envío.")
            return

        e1_ocupado = 0 if estados[0] == "DISPONIBLE" else 1
        e1_disponible = 1 if estados[0] == "DISPONIBLE" else 0

        e2_ocupado = 0 if estados[1] == "DISPONIBLE" else 1
        e2_disponible = 1 if estados[1] == "DISPONIBLE" else 0

        e3_ocupado = 0 if estados[2] == "DISPONIBLE" else 1
        e3_disponible = 1 if estados[2] == "DISPONIBLE" else 0

        try:
            val_v7 = round(float(tiempo_ia_val), 1) if tiempo_ia_val else 0
        except (ValueError, TypeError):
            val_v7 = 0

        # V6 - ASIGNACIÓN
        if asignacion is not None:
            texto_v6 = f"Dirigirse al espacio {asignacion}"
        else:
            texto_v6 = "Estacionamiento lleno"

        # V7 - TIEMPO IA
        if tiempo_ia_val is None:
        # Todos ocupados y esta llamada NO debe modificar V7
            texto_v7 = None

        else:
            try:
                val_v7 = round(float(tiempo_ia_val), 1)
            except (ValueError, TypeError):
                val_v7 = 0

            if val_v7 == 0:
                texto_v7 = "Hay espacios disponibles"
            else:
                texto_v7 = f"Proximo espacio libre en {val_v7} min"

        # DATOS BLYNK
        pines_valores = {
            "v0": e1_ocupado,
            "v1": e1_disponible,
            "v2": e2_ocupado,
            "v3": e2_disponible,
            "v4": e3_ocupado,
            "v5": e3_disponible,
            "v6": texto_v6,
        }

        # V7 solo se manda cuando corresponde.
        # Nunca se manda "Calculando..."
        if texto_v7 is not None:
            pines_valores["v7"] = texto_v7

        with requests.Session() as s:
            for pin, valor in pines_valores.items():
                try:
                    params = {
                        "token": BLYNK_AUTH_TOKEN,
                        pin: valor
                    }

                    r = s.get(
                        BLYNK_SERVER_URL,
                        params=params,
                        timeout=2
                    )

                    if r.status_code != 200:
                        print(
                            f"Blynk rechazo {pin}={valor} -> HTTP "
                            f"{r.status_code}: {r.text}"
                        )

                except Exception as e:
                    print(f"Error enviando {pin} a Blynk: {e}")

        print(
            f"Blynk actualizado | "
            f"E1:{e1_disponible} "
            f"E2:{e2_disponible} "
            f"E3:{e3_disponible} | "
            f"V6={texto_v6}"
            + (f" | V7={texto_v7}" if texto_v7 is not None else "")
        )

    threading.Thread(target=_tarea_envio, daemon=True).start()

# 1. HORA OFICIAL DE CHILE DESDE INTERNET
def obtener_tiempo_local():
    dias_semana = {
        0: "lunes",
        1: "martes",
        2: "miercoles",
        3: "jueves",
        4: "viernes",
        5: "sabado",
        6: "domingo",
    }
    meses_es = {
        "01": "enero",
        "02": "febrero",
        "03": "marzo",
        "04": "abril",
        "05": "mayo",
        "06": "junio",
        "07": "julio",
        "08": "agosto",
        "09": "septiembre",
        "10": "octubre",
        "11": "noviembre",
        "12": "diciembre",
    }

    headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}

    try:
        url = "http://worldtimeapi.org/api/timezone/America/Santiago"
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=3) as response:
            data = json.loads(response.read().decode())
            datetime_str = data["datetime"]

            fecha_part, hora_part = datetime_str.split("T")
            anio_s, mes_s, dia_s = fecha_part.split("-")
            hora_txt = hora_part.split(".")[0]
            day_of_week = data.get("day_of_week")

            if day_of_week is not None:
                nombre_dia = dias_semana.get(day_of_week, "")
                fecha_formateada = f"{nombre_dia} {int(dia_s)} de {meses_es.get(mes_s, mes_s)} de {anio_s}"
            else:
                fecha_formateada = (
                    f"{int(dia_s)} de {meses_es.get(mes_s, mes_s)} de {anio_s}"
                )

            return (
                dia_s,
                meses_es.get(mes_s, mes_s),
                int(anio_s),
                hora_txt,
                fecha_formateada,
            )

    except Exception:
        pass

    try:
        url_alt = "https://timeapi.io/api/time/current/zone?timeZone=America/Santiago"
        req_alt = urllib.request.Request(url_alt, headers=headers)
        with urllib.request.urlopen(req_alt, timeout=3) as response:
            data = json.loads(response.read().decode())

            dia_s = f"{data['day']:02d}"
            mes_num = f"{data['month']:02d}"
            mes_s = meses_es.get(mes_num, "enero")
            anio_s = data["year"]
            hora_txt = (
                f"{data['hour']:02d}:{data['minute']:02d}:{data['seconds']:02d}"
            )

            day_of_week_str = data.get("dayOfWeek", "").lower()
            m_dias = {
                "monday": "lunes",
                "tuesday": "martes",
                "wednesday": "miercoles",
                "thursday": "jueves",
                "friday": "viernes",
                "saturday": "sabado",
                "sunday": "domingo",
            }
            nombre_dia = m_dias.get(day_of_week_str, "")

            fecha_formateada = (
                f"{nombre_dia} {int(dia_s)} de {mes_s} de {anio_s}"
            )
            return dia_s, mes_s, int(anio_s), hora_txt, fecha_formateada

    except Exception:
        pass

    t_local = time.localtime()
    hora_sistema = time.strftime("%H:%M:%S", t_local)
    dia_sys = time.strftime("%d", t_local)
    mes_sys = meses_es.get(time.strftime("%m", t_local), "enero")
    anio_sys = t_local.tm_year

    return (
        dia_sys,
        mes_sys,
        anio_sys,
        hora_sistema,
        f"{dia_sys} de {mes_sys} de {anio_sys}",
    )

# 2. BASE DE DATOS LOCAL (.db)
def guardar_db_3_sensores(dia, mes, anio, hora, d1, est1, d2, est2, d3, est3):
    with db_lock:
        try:
            conexion = sqlite3.connect(archivo_db, timeout=10.0)
            cursor = conexion.cursor()
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS monitoreo_estacionamiento (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    dia TEXT, mes TEXT, anio INTEGER, hora TEXT,
                    dist_e1 REAL, estado_e1 TEXT,
                    dist_e2 REAL, estado_e2 TEXT,
                    dist_e3 REAL, estado_e3 TEXT
                )
            """)
            cursor.execute(
                """
                INSERT INTO monitoreo_estacionamiento
                (dia, mes, anio, hora, dist_e1, estado_e1, dist_e2, estado_e2, dist_e3, estado_e3)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
                (
                    dia,
                    mes,
                    anio,
                    hora,
                    float(d1),
                    est1,
                    float(d2),
                    est2,
                    float(d3),
                    est3,
                ),
            )

            conexion.commit()
            id_generado = cursor.lastrowid
            conexion.close()
            return id_generado
        except Exception as e:
            print(f"Error al guardar en BD: {e}")
            return 0

# 3. ENVIO DE BASE DE DATOS A LA IA (COLAB)
def bucle_envio_ia(app_ref):
    time.sleep(5)

    headers = {
        "ngrok-skip-browser-warning": "69420",
        "User-Agent": "RaspberryPi-Client",
    }

    while True:
        try:
            if not app_ref.todos_ocupados():
                time.sleep(5)
                continue

            elif os.path.exists(archivo_db):
                print(
                    "\n[...] 3 ESPACIOS OCUPADOS: ENVIANDO BASE DE DATOS A IA..."
                )

                with db_lock:
                    with open(archivo_db, "rb") as f:
                        archivos = {
                            "file": (
                                archivo_db,
                                f,
                                "application/octet-stream",
                            )
                        }

                        print("[...] Conectando con Colab...")

                        response = requests.post(
                            URL_ENDPOINT_IA,
                            files=archivos,
                            headers=headers,
                            timeout=30,
                            verify=False,
                        )

                print(
                    f"[...] Respuesta de Colab: HTTP {response.status_code}"
                )

                if response.status_code == 200:
                    respuesta_json = response.json()

                    print("\n RESPUESTA RECIBIDA DE LA IA:")
                    print(
                        json.dumps(
                            respuesta_json,
                            indent=4,
                            ensure_ascii=False
                        )
                    )

                    tiempo_val = None

                    claves_posibles = [
                        "minutos_faltantes_estimados",
                        "tiempo_estimado_desocupar_minutos",
                        "tiempo_estimado",
                        "prediccion",
                        "tiempo_restante",
                        "tiempo",
                        "minutos",
                        "prediction",
                        "time",
                        "estimated_time",
                    ]

                    for clave in claves_posibles:
                        if clave in respuesta_json:
                            tiempo_val = respuesta_json[clave]
                            print(
                                f"Valor IA encontrado en '{clave}': "
                                f"{tiempo_val}"
                            )
                            break

                    if tiempo_val is None and isinstance(
                        respuesta_json, dict
                    ):
                        valores = list(respuesta_json.values())

                        if len(valores) > 0:
                            tiempo_val = valores[0]

                            print(
                                f"No se encontro una clave conocida. "
                                f"Usando primer valor: {tiempo_val}"
                            )

                    if tiempo_val is not None:
                        try:
                            val_num = float(tiempo_val)
                            val_num = round(val_num, 1)
                            app_ref.ultimo_tiempo_ia = val_num
                            texto_mostrar = f"IA: Próximo espacio libre en aprox: {val_num} min"
                        except (ValueError, TypeError):
                            app_ref.ultimo_tiempo_ia = tiempo_val
                            texto_mostrar = (
                                f"IA: Proximo espacio libre en: {tiempo_val}"
                            )
                    else:
                        texto_mostrar = "IA: Estimacion no disponible"
                    # Actualizar GUI
                    app_ref.root.after(
                        0,
                        lambda texto=texto_mostrar:
                        app_ref.var_texto_ia.set(texto)
                    )

                    # Enviar el mismo valor a Blynk
                    print(f"[DEBUG] Enviando a Blynk V7 = {app_ref.ultimo_tiempo_ia}")

                    enviar_datos_blynk(
                        app_ref.estados_actuales,
                        None,
                        tiempo_ia_val=app_ref.ultimo_tiempo_ia,
                    )

                else:
                    print(
                        f"Error HTTP {response.status_code} "
                        f"desde Colab"
                    )

                    print(
                        f"Respuesta de Colab: {response.text[:500]}"
                    )

        except requests.exceptions.Timeout:
            print("TIMEOUT: Colab tardo mas de 30 segundos.")

        except requests.exceptions.ConnectionError as e:
            print(
                f"ERROR DE CONEXION CON COLAB/NGROK: {e}"
            )

        except Exception as e:
            print(
                f"Error en comunicacion con IA: {e}"
            )

        # IMPORTANTE: 600 segundos = 10 minutos
        time.sleep(INTERVALO_ENVIO_IA_SEGUNDOS)


    def bucle_monitoreo(self):
        try:
            arduino = serial.Serial(puerto_arduino, 9600, timeout=2)
            time.sleep(2)

            while self.ejecutando:
                dia, mes, anio, hora_txt, fecha_formateada = (
                    obtener_tiempo_local()
                )

                arduino.reset_input_buffer()
                t_inicio = time.perf_counter()

                arduino.write(b"E")
                linea = (
                    arduino.readline()
                    .decode("utf-8", errors="ignore")
                    .strip()
                )
                latencia_ms = (time.perf_counter() - t_inicio) * 1000

                if linea and linea != "SENSORES_APAGADOS":
                    try:
                        partes = linea.split(",")
                        if len(partes) == 3:
                            d1, d2, d3 = (
                                float(partes[0]),
                                float(partes[1]),
                                float(partes[2]),
                            )

                            estados = [
                                self.procesar_estado_espacio(0, d1),
                                self.procesar_estado_espacio(1, d2),
                                self.procesar_estado_espacio(2, d3),
                            ]

                            estacionamiento_asignado = self.calcular_asignacion(
                                estados
                            )

                            db_id = guardar_db_3_sensores(
                                dia,
                                mes,
                                anio,
                                hora_txt,
                                d1,
                                estados[0],
                                d2,
                                estados[1],
                                d3,
                                estados[2],
                            )

                            datos_medicion = {
                                "id": db_id,
                                "fecha": fecha_formateada,
                                "hora": hora_txt,
                                "tiempo_medicion": f"{round(latencia_ms)} ms",
                                "estacionamiento_asignado": (
                                    f"ESPACIO {estacionamiento_asignado}"
                                    if estacionamiento_asignado
                                    else "NINGUNO (LLENO)"
                                ),
                                "mediciones": {
                                    "estacionamiento_1": {
                                        "distancia_cm": d1,
                                        "estado": estados[0],
                                    },
                                    "estacionamiento_2": {
                                        "distancia_cm": d2,
                                        "estado": estados[1],
                                    },
                                    "estacionamiento_3": {
                                        "distancia_cm": d3,
                                        "estado": estados[2],
                                    },
                                },
                            }

                            print("\n--- LECTURA DE SENSORES (JSON) ---")
                            print(
                                json.dumps(
                                    datos_medicion, indent=4, ensure_ascii=False
                                )
                            )

                            self.root.after(
                                0,
                                self.actualizar_gui,
                                [d1, d2, d3],
                                estados,
                                latencia_ms,
                                db_id,
                                hora_txt,
                                estacionamiento_asignado,
                            )

                    except ValueError:
                        print(
                            f"[{hora_txt}] Error de formato al procesar linea:"
                            f" '{linea}'"
                        )
                else:
                    print(
                        f"[{hora_txt}] Sin respuesta del Arduino o sensores"
                        " apagados"
                    )

                time.sleep(INTERVALO_LECTURA)

        except Exception as e:
            print(f" Error en el puerto serie: {e}")


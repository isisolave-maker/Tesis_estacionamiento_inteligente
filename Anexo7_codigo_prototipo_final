    def todos_ocupados(self):
        return all(
            est in ["OCUPADO", "DETECTANDO"] for est in self.estados_actuales
        )

    def calcular_asignacion(self, estados):
        prioridad_orden = [2, 1, 0]  # Prioridad: Espacio 3, luego 2, luego 1
        for idx in prioridad_orden:
            if estados[idx] == "DISPONIBLE":
                return idx + 1
        return None

    def actualizar_texto_ia(self, texto):
        self.var_texto_ia.set(texto)

    def procesar_estado_espacio(self, idx, distancia):
        if DISTANCIA_MINIMA_VALIDA < distancia < DISTANCIA_UMBRAL_CM:
            self.contadores_confirmacion[idx] += 1
        else:
            self.contadores_confirmacion[idx] = 0

        lecturas = self.contadores_confirmacion[idx]
        if lecturas >= MUESTRAS_REQUERIDAS:
            return "OCUPADO"
        elif lecturas > 0:
            return "DETECTANDO"
        else:
            return "DISPONIBLE"

